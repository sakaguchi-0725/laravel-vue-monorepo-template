{
  "permissions": {
    "deny": [
      "Edit(./.prettierrc*)",
      "Edit(./.prettierignore)",
      "Edit(./prettier.config.*)",
      "Edit(./**/eslint.config.*)",
      "Edit(./**/.eslintrc*)",
      "Edit(./**/.eslintignore)",
      "Edit(./packages/eslint-config/**)",
      "Edit(./apps/api/phpstan*.neon*)",
      "Edit(./apps/api/tests/Architecture/**)",
      "Edit(./apps/api/pint.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-lefthook-bypass.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed-apps.sh\"",
            "timeout": 300,
            "statusMessage": "apps の差分に lint・format を実行中..."
          }
        ]
      }
    ]
  }
}
