{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "strict_param": true,
        "void_return": true,
        "no_useless_else": true,
        "single_trait_insert_per_statement": true,
        "ternary_to_null_coalescing": true,
        "no_superfluous_phpdoc_tags": {
            "allow_mixed": false,
            "allow_unused_params": false
        }
    }
}
