includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max

    # casts() メソッドの内容を解析させる。既定の false では属性の型が
    # マイグレーションのカラム型のままになり、enum / date キャストが効かない
    parseModelCastsMethod: true

    strictRules:
        # Eloquent のクエリビルダは larastan が静的メソッドとして型付けするため、
        # $query->orderBy() のようなチェーンがすべて誤検出になる
        dynamicCallOnStaticMethod: false

    paths:
        - app
        - config
        - database
        - routes

    phpat:
        ignore_built_in_classes: true

services:
    -
        class: Tests\Architecture\LayerDependencyTest
        tags:
            - phpat.test
    -
        class: Tests\Architecture\UseCaseTest
        tags:
            - phpat.test
    -
        class: Tests\Architecture\HttpTest
        tags:
            - phpat.test
    -
        class: Tests\Architecture\ExternalsTest
        tags:
            - phpat.test
    -
        class: Tests\Architecture\ExceptionTest
        tags:
            - phpat.test
